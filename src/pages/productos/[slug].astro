---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import Icon from '@/components/Icon.astro';
import { productWhatsappUrl } from '@/lib/whatsapp';
import { SITE } from '@/lib/site';
import { getProductImage } from '@/lib/product-image';
import { breadcrumbListSchema, type BreadcrumbItem } from '@/lib/schema';
import { evaluateProductIndexability } from '@/lib/product-indexability';
import { allProducts, primaryCategoryOf, relatedProducts } from '@/lib/catalog';

export function getStaticPaths() {
  return allProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const category = primaryCategoryOf(product);
const related = relatedProducts(product, 4);
const image = getProductImage(product.images);
const ctaUrl = productWhatsappUrl(product.name, product.whatsappMessage);
const productUrl = `${SITE.url}/productos/${product.slug}/`;
const indexability = evaluateProductIndexability(product as any);

// Una sola lista ordenada alimenta el breadcrumb visible y el JSON-LD (antes el JSON-LD
// omitía "Categorías" y la raíz no tenía barra final).
const crumbs: (BreadcrumbItem & { href: string })[] = [
  { name: 'Inicio', item: `${SITE.url}/`, href: '/' },
  { name: 'Categorías', item: `${SITE.url}/categorias/`, href: '/categorias/' },
  ...(category ? [{ name: category.name, item: `${SITE.url}/categorias/${category.slug}/`, href: `/categorias/${category.slug}/` }] : []),
  { name: product.name, item: productUrl, href: `/productos/${product.slug}/` },
];
const jsonLd = [breadcrumbListSchema(crumbs.map(({ name, item }) => ({ name, item })))];

// Hechos verificados (data/catalog-corrections.json). Lo pendiente de confirmar no se muestra.
const FACT_LABELS: Record<string, string> = {
  tipo: 'Tipo',
  material: 'Material',
  estructura: 'Estructura',
  mecanismo: 'Mecanismo',
  largo: 'Largo',
  medidas: 'Medidas',
  capacidad: 'Capacidad',
};
const facts = Object.entries((product.facts ?? {}) as Record<string, string>).filter(([k, v]) => FACT_LABELS[k] && v);
---

<BaseLayout
  title={product.seoTitle || `${product.name} Personalizado | Colombia`}
  description={product.seoDescription || product.shortDescription || product.description}
  ogImage={image}
  robots={indexability.indexable ? undefined : 'noindex, follow'}
  jsonLd={jsonLd}
>
  {/* El header ocupa espacio en el flujo (Header.astro: .header-accent-line { position: relative }),
       así que aquí no hace falta compensar su altura; antes pt-28 dejaba ~110px vacíos en móvil. */}
  <div class="bg-gray-50 pt-4 pb-3 lg:pt-6">
    <div class="container-ks">
      <nav aria-label="Ruta de navegación" class="flex items-center gap-x-2 gap-y-1 text-sm text-gray-600 flex-wrap">
        {crumbs.map((c, i) =>
          i < crumbs.length - 1 ? (
            <>
              <a href={c.href} class="hover:text-ks-navy transition-colors py-1">{c.name}</a>
              <span aria-hidden="true">/</span>
            </>
          ) : (
            <span class="text-ks-navy font-medium" aria-current="page">{c.name}</span>
          )
        )}
      </nav>
    </div>
  </div>

  <section class="py-6 lg:py-16">
    <div class="container-ks grid lg:grid-cols-2 gap-6 lg:gap-12">
      <div class="aspect-product rounded-2xl overflow-hidden bg-ks-navy-wash w-full max-w-[18rem] sm:max-w-sm mx-auto lg:max-w-none">
        <img src={image} alt={product.name} fetchpriority="high" decoding="async" class="w-full h-full object-cover" width="600" height="600" />
      </div>

      <div>
        {category && (
          <a href={`/categorias/${category.slug}/`} class="section-label mb-3 hidden sm:inline-flex">
            <Icon name="layers" size={14} /> {category.name}
          </a>
        )}
        <h1 class="text-2xl sm:text-4xl font-heading font-bold text-[#0A0A23] mb-3 sm:mb-4 leading-tight">{product.name}</h1>
        {product.shortDescription && <p class="text-base sm:text-lg text-gray-600 mb-5 sm:mb-8 leading-relaxed">{product.shortDescription}</p>}

        <a href={ctaUrl} target="_blank" rel="noopener noreferrer" data-primary-cta class="btn-whatsapp pulse-whatsapp w-full sm:w-auto justify-center mb-4 min-h-[48px]">
          <Icon name="message-circle" size={18} /> Cotizar por WhatsApp
        </a>
        <p class="text-sm text-gray-500 mb-8 leading-relaxed">
          Al cotizar te confirmamos cantidad mínima, técnica de marcación, colores disponibles y tiempo de producción.
          Enviamos a toda Colombia desde {SITE.operatingBase.split(',')[0]} ({SITE.metroAreaLabel}).
        </p>

        {facts.length > 0 && (
          <div class="mb-8">
            <h2 class="font-heading font-bold text-[#0A0A23] mb-3">Ficha del producto</h2>
            <dl class="grid grid-cols-[auto,1fr] gap-x-6 gap-y-2 text-sm">
              {facts.map(([k, v]) => (
                <>
                  <dt class="text-gray-500">{FACT_LABELS[k]}</dt>
                  <dd class="text-[#0A0A23] font-medium">{v}</dd>
                </>
              ))}
            </dl>
          </div>
        )}

        {product.features?.length > 0 && (
          <div class="mb-8">
            <h2 class="font-heading font-bold text-[#0A0A23] mb-3">Características</h2>
            <ul class="space-y-2.5">
              {product.features.map((f: string) => (
                <li class="flex items-start gap-2.5 text-gray-600 text-sm">
                  <Icon name="check-circle" size={16} class="text-ks-orange shrink-0 mt-0.5" />
                  {f}
                </li>
              ))}
            </ul>
          </div>
        )}

        {product.useCases?.length > 0 && (
          <div class="glass-card-light border border-gray-100 rounded-xl p-5 bg-ks-navy-ghost">
            <h2 class="font-heading font-bold text-[#0A0A23] mb-3 text-sm uppercase tracking-wide">Ideal para</h2>
            <ul class="space-y-2">
              {product.useCases.map((u: string) => (
                <li class="text-sm text-gray-600 flex items-start gap-2.5">
                  <Icon name="star" size={14} class="text-ks-navy shrink-0 mt-0.5" />
                  {u}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    {product.story && (
      <div class="container-ks max-w-3xl mt-12 lg:mt-16 pt-10 lg:pt-12 border-t border-gray-100">
        <h2 class="font-heading font-bold text-2xl text-[#0A0A23] mb-4">Sobre este producto</h2>
        <p class="text-gray-600 leading-relaxed whitespace-pre-line">{product.story}</p>
      </div>
    )}
  </section>

  {related.length > 0 && (
    <section class="py-16 lg:py-20 bg-ks-navy-ghost">
      <div class="container-ks">
        <h2 class="heading-underline text-2xl sm:text-3xl font-heading font-bold text-[#0A0A23] mb-10">
          También te puede interesar
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
